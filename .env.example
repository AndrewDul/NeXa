# NeXa environment template
#
# Copy to `.env` (which is gitignored) and fill in as subsystems are added.
# During M0 nothing here is consumed by any code. Keys are placeholders that
# document intended configuration surface, not committed configuration.

# --- General ---
# NEXA_ENV=development
# NEXA_LOG_LEVEL=info

# --- Data ownership / local-first (M4+) ---
# NEXA_DATA_DIR=./var

# --- Model providers (M1+; provider-independent by design) ---
# A provider is a replaceable abstraction. No provider name belongs in core
# control flow — only in configuration like this.
# NEXA_MODEL_PROVIDER=local
# NEXA_LOCAL_MODEL_ENDPOINT=http://127.0.0.1:11434

# --- Online model access (optional, M1+; minimum-context only) ---
# NEXA_ONLINE_MODEL_API_KEY=
